{
  "source": {
    "origin": "placeholder",
    "server": "https://mcp.chatplace.io/mcp",
    "note": "RECONSTRUCTED, NOT MEASURED. These tool names and schemas were inferred from public descriptions of ChatPlace (Instagram/Telegram/TikTok chatbots, funnels, carousels, broadcasts) — they are a plausible surface, not the real one. Replace this whole file with `npm run probe` or `npm run import-spec` to get an exact match. See spec/README.md."
  },
  "serverInfo": {
    "name": "chatplace-mcp",
    "version": "0.1.0",
    "title": "ChatPlace MCP (clone)"
  },
  "instructions": "Build and operate social-messaging automations: connect channels, define funnels, send messages and carousels, run broadcasts, and read analytics. Call list_channels first — almost every other tool needs a channel_id.",
  "tools": [
    {
      "name": "list_channels",
      "title": "List connected channels",
      "description": "List the social channels connected to the account (Instagram, Telegram, TikTok), with their ids and connection status. Most other tools take a channel_id from here.",
      "annotations": { "readOnlyHint": true, "openWorldHint": true },
      "inputSchema": {
        "type": "object",
        "properties": {
          "platform": {
            "type": "string",
            "description": "Restrict the result to one platform.",
            "enum": ["instagram", "telegram", "tiktok"]
          }
        },
        "additionalProperties": false
      },
      "outputSchema": {
        "type": "object",
        "properties": {
          "channels": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "channel_id": { "type": "string" },
                "platform": { "type": "string", "enum": ["instagram", "telegram", "tiktok"] },
                "handle": { "type": "string" },
                "status": { "type": "string", "enum": ["connected", "expired", "disconnected"] },
                "subscribers": { "type": "integer", "minimum": 0 }
              },
              "required": ["channel_id", "platform", "handle", "status"]
            }
          }
        },
        "required": ["channels"]
      }
    },
    {
      "name": "list_bots",
      "title": "List bots",
      "description": "List the bots configured on a channel.",
      "annotations": { "readOnlyHint": true },
      "inputSchema": {
        "type": "object",
        "properties": {
          "channel_id": { "type": "string", "description": "Channel to list bots for." },
          "limit": { "type": "integer", "minimum": 1, "maximum": 100, "default": 20 }
        },
        "required": ["channel_id"],
        "additionalProperties": false
      },
      "outputSchema": {
        "type": "object",
        "properties": {
          "bots": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "bot_id": { "type": "string" },
                "name": { "type": "string" },
                "status": { "type": "string", "enum": ["draft", "live", "paused"] }
              },
              "required": ["bot_id", "name", "status"]
            }
          }
        },
        "required": ["bots"]
      }
    },
    {
      "name": "create_bot",
      "title": "Create a bot",
      "description": "Create a bot on a channel. The bot starts as a draft; publish_flow makes it live.",
      "annotations": { "destructiveHint": false, "idempotentHint": false },
      "inputSchema": {
        "type": "object",
        "properties": {
          "channel_id": { "type": "string" },
          "name": { "type": "string", "minLength": 1, "maxLength": 120 },
          "description": { "type": "string", "maxLength": 1000 },
          "greeting": { "type": "string", "description": "First message sent to a new subscriber.", "maxLength": 2000 }
        },
        "required": ["channel_id", "name"],
        "additionalProperties": false
      },
      "outputSchema": {
        "type": "object",
        "properties": {
          "bot_id": { "type": "string" },
          "status": { "type": "string", "enum": ["draft", "live", "paused"] }
        },
        "required": ["bot_id", "status"]
      }
    },
    {
      "name": "create_flow",
      "title": "Create a funnel flow",
      "description": "Define a funnel: an ordered set of steps the subscriber moves through. Each step sends content and optionally waits for a reply or a button press.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "bot_id": { "type": "string" },
          "name": { "type": "string", "minLength": 1, "maxLength": 120 },
          "steps": {
            "type": "array",
            "minItems": 1,
            "description": "Ordered funnel steps.",
            "items": {
              "type": "object",
              "properties": {
                "type": { "type": "string", "enum": ["message", "question", "carousel", "delay", "tag", "handoff"] },
                "text": { "type": "string", "maxLength": 2000 },
                "buttons": {
                  "type": "array",
                  "maxItems": 3,
                  "items": {
                    "type": "object",
                    "properties": {
                      "label": { "type": "string", "maxLength": 20 },
                      "next_step": { "type": "integer", "minimum": 0 },
                      "url": { "type": "string", "format": "uri" }
                    },
                    "required": ["label"]
                  }
                },
                "delay_seconds": { "type": "integer", "minimum": 0, "maximum": 604800 },
                "tag": { "type": "string" }
              },
              "required": ["type"]
            }
          }
        },
        "required": ["bot_id", "name", "steps"],
        "additionalProperties": false
      },
      "outputSchema": {
        "type": "object",
        "properties": {
          "flow_id": { "type": "string" },
          "step_count": { "type": "integer" },
          "status": { "type": "string", "enum": ["draft", "published"] }
        },
        "required": ["flow_id", "step_count", "status"]
      }
    },
    {
      "name": "publish_flow",
      "title": "Publish a flow",
      "description": "Make a flow live so it starts running for subscribers. Publishing replaces the currently live version of the flow.",
      "annotations": { "destructiveHint": true, "idempotentHint": true },
      "inputSchema": {
        "type": "object",
        "properties": {
          "flow_id": { "type": "string" }
        },
        "required": ["flow_id"],
        "additionalProperties": false
      },
      "outputSchema": {
        "type": "object",
        "properties": {
          "flow_id": { "type": "string" },
          "status": { "type": "string", "enum": ["draft", "published"] },
          "published_at": { "type": "string", "format": "date-time" }
        },
        "required": ["flow_id", "status"]
      }
    },
    {
      "name": "create_carousel",
      "title": "Create a carousel",
      "description": "Build a horizontally scrollable card carousel that a flow step or a direct message can send.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "bot_id": { "type": "string" },
          "name": { "type": "string", "maxLength": 120 },
          "cards": {
            "type": "array",
            "minItems": 1,
            "maxItems": 10,
            "items": {
              "type": "object",
              "properties": {
                "title": { "type": "string", "maxLength": 80 },
                "subtitle": { "type": "string", "maxLength": 80 },
                "image_url": { "type": "string", "format": "uri" },
                "buttons": {
                  "type": "array",
                  "maxItems": 3,
                  "items": {
                    "type": "object",
                    "properties": {
                      "label": { "type": "string", "maxLength": 20 },
                      "url": { "type": "string", "format": "uri" },
                      "payload": { "type": "string" }
                    },
                    "required": ["label"]
                  }
                }
              },
              "required": ["title"]
            }
          }
        },
        "required": ["bot_id", "cards"],
        "additionalProperties": false
      },
      "outputSchema": {
        "type": "object",
        "properties": {
          "carousel_id": { "type": "string" },
          "card_count": { "type": "integer" }
        },
        "required": ["carousel_id", "card_count"]
      }
    },
    {
      "name": "send_message",
      "title": "Send a direct message",
      "description": "Send a message to one subscriber. Platform messaging windows apply: outside the allowed window the send is rejected rather than queued.",
      "annotations": { "destructiveHint": false, "openWorldHint": true },
      "inputSchema": {
        "type": "object",
        "properties": {
          "channel_id": { "type": "string" },
          "subscriber_id": { "type": "string" },
          "text": { "type": "string", "minLength": 1, "maxLength": 2000 },
          "carousel_id": { "type": "string", "description": "Send a carousel instead of, or alongside, text." },
          "quick_replies": {
            "type": "array",
            "maxItems": 5,
            "items": { "type": "string", "maxLength": 20 }
          }
        },
        "required": ["channel_id", "subscriber_id"],
        "additionalProperties": false
      },
      "outputSchema": {
        "type": "object",
        "properties": {
          "message_id": { "type": "string" },
          "delivered": { "type": "boolean" },
          "error": { "type": "string" }
        },
        "required": ["message_id", "delivered"]
      }
    },
    {
      "name": "create_broadcast",
      "title": "Create a broadcast",
      "description": "Send a message to a segment of subscribers, immediately or at a scheduled time.",
      "annotations": { "destructiveHint": true, "openWorldHint": true },
      "inputSchema": {
        "type": "object",
        "properties": {
          "channel_id": { "type": "string" },
          "text": { "type": "string", "minLength": 1, "maxLength": 2000 },
          "segment": {
            "type": "object",
            "description": "Who receives it. Omit to target every active subscriber.",
            "properties": {
              "tags": { "type": "array", "items": { "type": "string" } },
              "active_within_days": { "type": "integer", "minimum": 1, "maximum": 365 }
            }
          },
          "scheduled_at": { "type": "string", "format": "date-time", "description": "ISO 8601. Omit to send now." }
        },
        "required": ["channel_id", "text"],
        "additionalProperties": false
      },
      "outputSchema": {
        "type": "object",
        "properties": {
          "broadcast_id": { "type": "string" },
          "recipient_estimate": { "type": "integer" },
          "status": { "type": "string", "enum": ["scheduled", "sending", "sent"] }
        },
        "required": ["broadcast_id", "status"]
      }
    },
    {
      "name": "set_trigger",
      "title": "Set an automation trigger",
      "description": "Start a flow when something happens: a keyword in a DM, a comment on a post, a story reply, or a new follower.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "bot_id": { "type": "string" },
          "flow_id": { "type": "string" },
          "event": {
            "type": "string",
            "enum": ["dm_keyword", "comment_keyword", "story_reply", "new_follower", "post_published"]
          },
          "keywords": {
            "type": "array",
            "items": { "type": "string", "minLength": 1 },
            "description": "Required for keyword events. Matched case-insensitively."
          },
          "post_id": { "type": "string", "description": "Limit a comment trigger to one post." }
        },
        "required": ["bot_id", "flow_id", "event"],
        "additionalProperties": false
      },
      "outputSchema": {
        "type": "object",
        "properties": {
          "trigger_id": { "type": "string" },
          "active": { "type": "boolean" }
        },
        "required": ["trigger_id", "active"]
      }
    },
    {
      "name": "list_subscribers",
      "title": "List subscribers",
      "description": "Page through the subscribers of a channel, optionally filtered by tag.",
      "annotations": { "readOnlyHint": true },
      "inputSchema": {
        "type": "object",
        "properties": {
          "channel_id": { "type": "string" },
          "tag": { "type": "string" },
          "limit": { "type": "integer", "minimum": 1, "maximum": 200, "default": 50 },
          "cursor": { "type": "string", "description": "Opaque cursor from a previous page." }
        },
        "required": ["channel_id"],
        "additionalProperties": false
      },
      "outputSchema": {
        "type": "object",
        "properties": {
          "subscribers": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "subscriber_id": { "type": "string" },
                "handle": { "type": "string" },
                "tags": { "type": "array", "items": { "type": "string" } },
                "subscribed_at": { "type": "string", "format": "date-time" }
              },
              "required": ["subscriber_id", "handle"]
            }
          },
          "next_cursor": { "type": "string" }
        },
        "required": ["subscribers"]
      }
    },
    {
      "name": "tag_subscriber",
      "title": "Tag a subscriber",
      "description": "Add or remove tags on a subscriber. Tags drive broadcast segments and flow branching.",
      "annotations": { "idempotentHint": true },
      "inputSchema": {
        "type": "object",
        "properties": {
          "channel_id": { "type": "string" },
          "subscriber_id": { "type": "string" },
          "add": { "type": "array", "items": { "type": "string" } },
          "remove": { "type": "array", "items": { "type": "string" } }
        },
        "required": ["channel_id", "subscriber_id"],
        "additionalProperties": false
      },
      "outputSchema": {
        "type": "object",
        "properties": {
          "subscriber_id": { "type": "string" },
          "tags": { "type": "array", "items": { "type": "string" } }
        },
        "required": ["subscriber_id", "tags"]
      }
    },
    {
      "name": "get_analytics",
      "title": "Get analytics",
      "description": "Read engagement and conversion metrics for a channel, bot, or flow over a date range.",
      "annotations": { "readOnlyHint": true },
      "inputSchema": {
        "type": "object",
        "properties": {
          "channel_id": { "type": "string" },
          "bot_id": { "type": "string" },
          "flow_id": { "type": "string" },
          "from": { "type": "string", "format": "date" },
          "to": { "type": "string", "format": "date" },
          "metrics": {
            "type": "array",
            "items": {
              "type": "string",
              "enum": ["sent", "delivered", "opened", "clicked", "replied", "converted", "unsubscribed"]
            }
          }
        },
        "required": ["channel_id"],
        "additionalProperties": false
      },
      "outputSchema": {
        "type": "object",
        "properties": {
          "range": {
            "type": "object",
            "properties": { "from": { "type": "string" }, "to": { "type": "string" } }
          },
          "totals": { "type": "object", "additionalProperties": { "type": "number" } },
          "series": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "date": { "type": "string", "format": "date" },
                "values": { "type": "object", "additionalProperties": { "type": "number" } }
              },
              "required": ["date", "values"]
            }
          }
        },
        "required": ["totals"]
      }
    }
  ]
}
