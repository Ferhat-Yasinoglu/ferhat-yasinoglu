# Comma-separated API keys this server will accept as `Authorization: Bearer <key>`.
# Leave empty and auth is DISABLED — fine locally, never in public.
CHATPLACE_API_KEYS=

# Force auth off even when keys are set. Local development only.
# CHATPLACE_AUTH_DISABLED=1

# Where to listen.
PORT=3000
HOST=0.0.0.0
MCP_PATH=/mcp

# Override the tool spec location. Defaults to ./spec/tools.json.
# CHATPLACE_SPEC=/etc/chatplace/tools.json

# Used by `npm run probe` when --url / --key are not passed.
# MCP_URL=https://mcp.chatplace.io/mcp
# MCP_API_KEY=
