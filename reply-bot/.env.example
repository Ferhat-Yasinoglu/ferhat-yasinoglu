# Copy to .env; npm run dev / start / try read it. A variable already exported
# in your shell wins over the value here — the environment is never overwritten.
#
# A channel switches on as soon as it has credentials of its own. Fill in one
# block, the other, or both.

# --- Shared -----------------------------------------------------------------
BOT_RULES_FILE=rules.json
BOT_MAX_REPLY_CHARS=280

# Decide and log, send nothing. The safe way to watch it for a day.
# BOT_DRY_RUN=1

PORT=3000
HOST=0.0.0.0

# --- Web panel (optional) ---------------------------------------------------
# Set a password and the panel appears at /panel: the checks the doctor prints,
# the settings below as form fields, the rules file as an editor, a box that
# runs one message through the bot, and the last few hundred decisions.
#
# No password, no panel — it is not mounted at all, so a deployment that never
# sets one cannot be reached even by guessing. Twelve characters minimum,
# because everything below is reachable from behind it.
# PANEL_PASSWORD=

# Where the panel writes what you type into it. On Fly this must be a volume,
# or the settings vanish the next time the machine restarts.
# BOT_DATA_DIR=data

# Only behind a proxy you trust to set X-Forwarded-For (Fly does). Off, every
# request looks like it came from the proxy, so one wrong password locks
# everyone out; on, the header can be forged by anyone who knows to try.
# PANEL_TRUST_PROXY=1

# Printed in the panel's "paste this into Meta" box, when you know it already.
# PANEL_PUBLIC_URL=https://reply-bot.fly.dev

# --- Instagram comments -----------------------------------------------------
# Long-lived token with instagram_manage_comments (and instagram_manage_messages
# for DM replies). Treat it as a password.
IG_ACCESS_TOKEN=

# The Instagram professional account id. Also used to ignore your own comments,
# which is what stops the bot answering itself in a loop.
IG_USER_ID=

# The string you also type into "Verify token" when you subscribe the webhook.
IG_VERIFY_TOKEN=

# App secret from the Meta app dashboard. Signs every delivery — leave it empty
# only on localhost, otherwise anyone with the URL can make the bot post.
IG_APP_SECRET=

# IG_WEBHOOK_PATH=/webhook/instagram
# IG_GRAPH_URL=https://graph.facebook.com/v21.0

# --- WhatsApp messages ------------------------------------------------------
# Cloud API token with whatsapp_business_messaging.
WA_ACCESS_TOKEN=

# The phone number id from the WhatsApp panel — not the phone number itself.
WA_PHONE_NUMBER_ID=

WA_VERIFY_TOKEN=
WA_APP_SECRET=

# WhatsApp only delivers free-form text within 24 hours of the person's last
# message; outside it nothing but an approved template goes through. The bot
# stays silent rather than sending something that bounces. Lower it to test.
# WA_WINDOW_HOURS=24

# WA_WEBHOOK_PATH=/webhook/whatsapp
# WA_GRAPH_URL=https://graph.facebook.com/v21.0

# --- Claude fallback (optional) ---------------------------------------------
# Messages no rule matches are answered by Claude — but only when BOTH the key
# and the brief below are set. Without them the bot stays rules-only.
ANTHROPIC_API_KEY=
# BOT_MODEL=claude-opus-5

# The account brief. Facts the model may use and the voice it should use them
# in; it is told to say nothing rather than go outside this. The prompt also
# tells it which channel it is writing into.
BOT_PERSONA="Farhad Yaqoobi (Ferhat Yasinoglu) — IT student in NRW, Germany.
Personal account: projects, code and a learning journal. Not a shop.
Speaks German, Turkish, English and Persian — always answer in the message's language.
Builds offline-first web apps with vanilla JavaScript (ES6+), CSS3 and Firestore,
service workers and a web app manifest. No framework, no build step.
Projects: Açık Defter, a four-language personal site and learning journal that keeps
working offline (ferhat-yasinoglu.github.io/acik-defter/); netstore, an offline-first
storefront; the animated cards on the GitHub profile, generated by a Node script.
Code: github.com/Ferhat-Yasinoglu
Tone: friendly, modest, short. No marketing language.
Work or collaboration questions get a promise to come back — never quote a price,
a rate or a deadline, and never commit to taking a job on.
Say nothing rather than guess at technical detail."
