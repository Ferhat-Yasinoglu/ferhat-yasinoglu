# kazi ortam değişkenleri. Bu dosyayı .env olarak kopyalayıp doldurun:  cp .env.example .env
# .env gerçek şifre içerir: GitHub'a YÜKLEMEYİN, kimseye göndermeyin.
# Kullanım (yerelde):  set -a; . ./.env; set +a; kazi serve --host 0.0.0.0 --port 8000
# Render'da bu dosya kullanılmaz; değişkenler panelden (Environment) girilir.

# ZORUNLU. Arayüze girerken yazacağınız şifre. Boşken sunucu hiç başlamaz.
# En az 16 karakter, rastgele olsun. Üretmek için:
#   python -c "import secrets; print(secrets.token_urlsafe(24))"
# Kimseyle paylaşmayın: bunu bilen herkes sunucunuzu kullanabilir.
KAZI_TOKEN=

# İSTEĞE BAĞLI ve ÜCRETLİ. Yalnız "Veri çıkarma" (extract) için gerekir; anahtar yoksa
# Veri çıkarma kapalı kalır, sayfayı Markdown'a çevirme çalışmaya devam eder.
# Anthropic'e her çağrıda para ödenir. Claude abonelik üyeliği bunun yerine geçmez; ayrı faturalanır.
ANTHROPIC_API_KEY=

# İSTEĞE BAĞLI. 1 = sunucuda "JS ile aç" seçeneği izinli. Varsayılan 0 (kapalı).
# Docker imajında Playwright/Chromium yoktur; 1 yapmak tek başına yetmez, ayrıca kurulum gerekir
# (bkz. Dockerfile başındaki not). Ücretsiz barındırmada kapalı bırakın.
KAZI_ALLOW_JS=0

# İSTEĞE BAĞLI ayarlar (satırın başındaki # işaretini kaldırırsanız geçerli olur).
# Verilen değerler varsayılanlardır.
# KAZI_MODEL=claude-sonnet-5-5   # Veri çıkarma için model
# KAZI_MAX_CONCURRENT=3          # aynı anda en çok kaç sayfa çekilsin
# KAZI_RATE_PER_MIN=30           # dakikada en çok kaç istek
# KAZI_TIMEOUT=90                # bir istek en çok kaç saniye sürsün
