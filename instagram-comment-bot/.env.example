# Copy to .env; npm run dev / start / try read it. A variable already exported
# in your shell wins over the value here — the environment is never overwritten.
#
# --- Meta app ---------------------------------------------------------------
# The string you also type into "Verify token" when you subscribe the webhook.
IG_VERIFY_TOKEN=change-me

# App secret from the Meta app dashboard. Signs every delivery — leave it empty
# only on localhost, otherwise anyone with the URL can make the bot post.
IG_APP_SECRET=

# --- Instagram account ------------------------------------------------------
# Long-lived token with instagram_manage_comments (and instagram_manage_messages
# for DM replies). Treat it as a password.
IG_ACCESS_TOKEN=

# The Instagram professional account id. Also used to ignore your own comments,
# which is what stops the bot answering itself in a loop.
IG_USER_ID=

# IG_GRAPH_URL=https://graph.facebook.com/v21.0

# --- Bot --------------------------------------------------------------------
IG_RULES_FILE=rules.json
IG_MAX_REPLY_CHARS=280

# Decide and log, post nothing. The safe way to watch it for a day.
# IG_DRY_RUN=1

# --- Claude fallback (optional) ---------------------------------------------
# Comments no rule matches are answered by Claude — but only when BOTH the key
# and the brief below are set. Without them the bot stays rules-only.
ANTHROPIC_API_KEY=
# IG_MODEL=claude-opus-5

# The account brief. Facts the model may use and the voice it should use them
# in; it is told to say nothing rather than go outside this.
IG_PERSONA="Farhad Yaqoobi (Ferhat Yasinoglu) — IT student in NRW, Germany.
Personal account: projects, code and a learning journal. Not a shop.
Speaks German, Turkish, English and Persian — always answer in the comment's language.
Builds offline-first web apps with vanilla JavaScript (ES6+), CSS3 and Firestore,
service workers and a web app manifest. No framework, no build step.
Projects: Açık Defter, a four-language personal site and learning journal that keeps
working offline (ferhat-yasinoglu.github.io/acik-defter/); netstore, an offline-first
storefront; the animated cards on the GitHub profile, generated by a Node script.
Code: github.com/Ferhat-Yasinoglu
Tone: friendly, modest, short. No marketing language.
Work or collaboration questions go to DM — never quote a price, a rate or a deadline,
and never promise to take a job on. Say nothing rather than guess at technical detail."

# --- Server -----------------------------------------------------------------
PORT=3000
HOST=0.0.0.0
# IG_WEBHOOK_PATH=/webhook
