{
  "mcpServers": {
    "botflow": {
      "command": "node",
      "args": ["--disable-warning=ExperimentalWarning", "dist/src/index.js", "--stdio"],
      "env": {
        "BOTFLOW_DB": "botflow.db"
      }
    },
    "playwright": {
      "type": "stdio",
      "command": "npx",
      "args": ["-y", "@playwright/mcp@latest"],
      "env": {}
    }
  }
}
