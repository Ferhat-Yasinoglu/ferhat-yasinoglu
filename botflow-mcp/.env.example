# Comma-separated API keys this server accepts as `Authorization: Bearer <key>`.
# Leave empty and auth is DISABLED — fine locally, never in public.
BOTFLOW_API_KEYS=

# Force auth off even when keys are set. Local development only.
# BOTFLOW_AUTH_DISABLED=1

# SQLite file holding bots, flows, subscribers and history.
# It contains bot tokens in plain text — treat it as a secret.
# Use :memory: for a throwaway instance that forgets everything on exit.
BOTFLOW_DB=botflow.db

# Where to listen.
PORT=3000
HOST=0.0.0.0
MCP_PATH=/mcp

# Point the Telegram client somewhere else, e.g. a local mock.
# TELEGRAM_API_URL=https://api.telegram.org
