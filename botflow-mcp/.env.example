# Comma-separated API keys this server accepts as `Authorization: Bearer <key>`.
# Leave empty and auth is DISABLED — fine locally, never in public.
BOTFLOW_API_KEYS=

# Force auth off even when keys are set. Local development only.
# BOTFLOW_AUTH_DISABLED=1

# SQLite file holding bots, flows, subscribers and history.
# It contains bot tokens in plain text — treat it as a secret.
# Use :memory: for a throwaway instance that forgets everything on exit.
BOTFLOW_DB=botflow.db

# Where to listen.
PORT=3000
HOST=0.0.0.0
MCP_PATH=/mcp

# Point the Telegram client somewhere else, e.g. a local mock.
# TELEGRAM_API_URL=https://api.telegram.org

# Republish another MCP server's tools through this one. Its surface is read at
# startup, so nothing about it has to be written down here.
# BOTFLOW_UPSTREAM_URL=https://mcp.chatplace.io/mcp
# BOTFLOW_UPSTREAM_KEY=
# BOTFLOW_UPSTREAM_NAME=chatplace   # default: derived from the host
# BOTFLOW_UPSTREAM_PREFIX=chatplace_ # default: <name>_, empty string for none
# BOTFLOW_UPSTREAM_TIMEOUT_MS=15000

# More than one, as JSON. Takes precedence over the single-server variables.
# BOTFLOW_UPSTREAMS=[{"name":"chatplace","url":"https://mcp.chatplace.io/mcp","apiKey":"…"}]
